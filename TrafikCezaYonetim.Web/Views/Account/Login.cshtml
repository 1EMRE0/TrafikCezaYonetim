@using TrafikCezaYonetim.Business.DTOs
@model LoginDto

@{
    ViewData["Title"] = "Giriş Yap";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap - Trafik Ceza Takip Sistemi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background-color: #ffffff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            margin: 0;
            padding: 20px 0;
        }

        .login-container {
            width: 100%;
            max-width: 400px;
            padding: 20px;
            text-align: center;
        }

        /* Miro Başlık Tipografisi */
        .brand-title-top {
            font-family: "Georgia", "Times New Roman", serif;
            font-size: 2.4rem;
            font-weight: 900;
            letter-spacing: 2px;
            color: #111111;
            margin-bottom: 2px;
        }

        .brand-title-bottom {
            font-size: 1.6rem;
            font-weight: 800;
            letter-spacing: 1.5px;
            color: #111111;
            margin-bottom: 28px;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 800;
            color: #111111;
            margin-bottom: 4px;
            letter-spacing: 0.5px;
        }

        .section-subtitle {
            font-size: 0.78rem;
            font-weight: 700;
            color: #333333;
            letter-spacing: 0.5px;
            margin-bottom: 35px;
        }

        /* Form Elemanları */
        .form-group-custom {
            text-align: left;
            margin-bottom: 20px;
        }

        .form-label-custom {
            font-size: 0.95rem;
            font-weight: 600;
            color: #222222;
            margin-bottom: 6px;
            display: block;
        }

        .form-control-custom {
            width: 100%;
            padding: 7px 12px;
            font-size: 0.9rem;
            border: 1px solid #777777;
            border-radius: 2px;
            outline: none;
            background-color: #ffffff;
            transition: border-color 0.15s ease-in-out;
        }

        .form-control-custom:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
        }

        /* Miro Buton Stilleri */
        .btn-login {
            background-color: #5b9bf8;
            color: #ffffff;
            font-size: 0.85rem;
            font-weight: 700;
            padding: 10px 0;
            border-radius: 25px;
            border: none;
            width: 100%;
            letter-spacing: 0.5px;
            transition: background-color 0.2s ease;
        }

        .btn-login:hover {
            background-color: #4384e6;
            color: #ffffff;
        }

        .btn-personnel {
            background-color: #f7d2aa;
            color: #222222;
            font-size: 0.82rem;
            font-weight: 700;
            padding: 9px 0;
            border-radius: 25px;
            border: none;
            width: 100%;
            margin-top: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-decoration: none;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        .btn-personnel:hover {
            background-color: #ecc090;
            color: #111111;
        }

        /* Alt Linkler */
        .links-area {
            margin-top: 25px;
        }

        .link-forgot {
            font-size: 0.85rem;
            color: #3b82f6;
            text-decoration: none;
            display: inline-block;
            margin-bottom: 12px;
        }

        .link-forgot:hover {
            text-decoration: underline;
        }

        .link-register {
            font-size: 0.85rem;
            color: #3b82f6;
            text-decoration: underline;
            display: inline-block;
        }

        .link-register:hover {
            color: #1d4ed8;
        }

        /* Test Hesapları Bilgi Kutusu */
        .test-info-box {
            margin-top: 25px;
            padding: 12px;
            background-color: #f8fafc;
            border: 1px dashed #cbd5e1;
            border-radius: 8px;
            font-size: 0.75rem;
            text-align: left;
            color: #64748b;
        }
    </style>
</head>
<body>

<div class="login-container">
    <!-- Üst Başlık Grubu -->
    <div class="brand-title-top">TRAFİK</div>
    <div class="brand-title-bottom">CEZA TAKİP SİSTEMİ</div>

    <div class="section-title">GİRİŞ YAP</div>
    <div class="section-subtitle">HESABINIZLA GİRİŞ YAPIN</div>

    <!-- Giriş Formu -->
    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 small text-start mb-3" style="font-size: 0.8rem;">
                <div asp-validation-summary="All" class="mb-0"></div>
            </div>
        }

        <div class="form-group-custom">
            <label class="form-label-custom">E-Posta / Kullanıcı Adı</label>
            <input asp-for="Username" id="usernameInput" class="form-control-custom" placeholder="ornek@gmail.com" required autofocus />
        </div>

        <div class="form-group-custom">
            <label class="form-label-custom">Şifre</label>
            <input asp-for="Password" id="passwordInput" type="password" class="form-control-custom" placeholder="••••••••" required />
        </div>

        <!-- Mavi Giriş Yap Butonu -->
        <button type="submit" class="btn-login mt-2">
            GİRİŞ YAP
        </button>

        <!-- Turuncu Personel Hızlı Giriş Butonu -->
        <button type="button" class="btn-personnel" onclick="quickPersonnelLogin()">
            <i class="bi bi-person-fill fs-6"></i>
            <span>PERSONEL GİRİŞİ</span>
        </button>
    </form>

    <!-- Alt Linkler -->
    <div class="links-area">
        <div>
            <a href="javascript:void(0)" onclick="alert('Şifre sıfırlama talebiniz sistem yöneticisine iletilmiştir.')" class="link-forgot">
                Şifrenizi mi Unuttunuz?
            </a>
        </div>
        <div>
            <a href="javascript:void(0)" onclick="alert('Yeni personel kaydı yalnızca İK veya Sistem Yöneticisi tarafından açılabilir.')" class="link-register">
                Hesabınız Yok Mu ? Kayıt olun
            </a>
        </div>
    </div>

    <!-- Test Hesapları Bilgilendirmesi -->
    <div class="test-info-box">
        <strong>Hızlı Test Girişleri (Şifre: 123456):</strong><br>
        • <strong>Yönetici:</strong> <code>yonetici</code><br>
        • <strong>Finans:</strong> <code>finans</code><br>
        • <em>(Personel için yukarıdaki butona tıklayabilirsiniz)</em>
    </div>
</div>

<script>
    // Miro'daki 'PERSONEL GİRİŞİ' butonuna basıldığında formu otomatik doldurup giriş yaptırır
    function quickPersonnelLogin() {
        document.getElementById('usernameInput').value = 'personel';
        document.getElementById('passwordInput').value = '123456';
        document.forms[0].submit();
    }
</script>

</body>
</html>